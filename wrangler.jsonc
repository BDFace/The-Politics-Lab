{
  // Plain HTML, CSS and JS with no build step.
  // Cloudflare serves everything in ./public as static assets.
  "name": "the-politics-lab",
  "compatibility_date": "2026-10-01",
  // A workers.dev address for the live site, and a preview link for every branch.
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Branch builds run `wrangler preview`, which needs this block (it can be empty).
  "previews": {}
}
